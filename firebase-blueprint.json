{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "A multiplayer game session",
      "type": "object",
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "color": { "type": "string" },
              "gold": { "type": "number" }
            }
          }
        },
        "map": {
          "type": "object",
          "description": "Serialized map data"
        },
        "currentTurn": { "type": "integer" },
        "status": { "type": "string", "enum": ["lobby", "playing", "finished"] },
        "winnerId": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["players", "map", "currentTurn", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "alias": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "wins": { "type": "number" },
            "losses": { "type": "number" },
            "gamesPlayed": { "type": "number" },
            "totalGoldSpent": { "type": "number" },
            "totalGoldEarned": { "type": "number" },
            "totalTilesClaimed": { "type": "number" }
          }
        }
      },
      "required": ["uid", "displayName", "alias"]
    },
    "GameStats": {
      "title": "GameStats",
      "description": "Statistics for a specific game",
      "type": "object",
      "properties": {
        "gameId": { "type": "string" },
        "unitsPurchased": { "type": "number" },
        "goldEarned": { "type": "number" },
        "tilesClaimed": { "type": "number" },
        "isWin": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["gameId", "unitsPurchased", "goldEarned", "tilesClaimed", "isWin"]
    }
  },
  "firestore": {
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Active game sessions"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/gameStats/{statId}": {
      "schema": "GameStats",
      "description": "User's game statistics"
    }
  }
}
